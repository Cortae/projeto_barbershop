NODE_ENV=development
PORT=3000
SPRING_API_URL=http://localhost:8080
UPSTREAM_TIMEOUT_MS=10000
REQUEST_BODY_LIMIT=1mb

# open: entrega a resposta mesmo se a auditoria falhar; closed: responde 503.
AUDIT_FAILURE_MODE=open
AUDIT_BODY_MAX_BYTES=65536

# Origens separadas por vírgula. Vazio desabilita CORS (o proxy Vite não precisa dele).
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_barbershop
DB_USER=barbershop_logger
DB_PASSWORD=troque-esta-senha
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=3000

# Permite associar X-User-Id ao log somente fora de produção.
ALLOW_DEV_USER_HEADER=true
