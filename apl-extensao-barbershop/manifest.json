{
  "manifest_version": 3,
  "name": "JR Barbershop - Agendamento rápido",
  "description": "Cadastre agendamentos sem sair da guia atual.",
  "version": "1.3.0",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icon.png",
    "32": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "action": {
    "default_title": "Novo agendamento",
    "default_icon": "assets/icon.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
